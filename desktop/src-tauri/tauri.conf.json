{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conflux",
  "version": "0.1.0",
  "identifier": "com.conflux.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Conflux",
        "width": 940,
        "height": 680,
        "minWidth": 620,
        "minHeight": 460,
        "backgroundColor": "#f4f3efff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:8080"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
