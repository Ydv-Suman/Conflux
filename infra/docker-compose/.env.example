# Copy this file to .env and replace secret values before starting Compose.

# Required local secrets
POSTGRES_PASSWORD=identity123
WORKSPACE_POSTGRES_PASSWORD=workspace123
INTERNAL_GRPC_TOKEN=replace-with-at-least-32-random-characters

# Existing local PostgreSQL data directories
POSTGRES_DATA_PATH=/Users/sumanyadav/Desktop/Database/Conflux_identity/pgdata
WORKSPACE_POSTGRES_DATA_PATH=/Users/sumanyadav/Desktop/Database/conflux_workspace/pgdata

# Identity URLs and browser security
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_SECURE_COOKIES=false
AUTH_COOKIE_SAME_SITE=Strict
FORWARD_HEADERS_STRATEGY=none

# JWT behavior; key files are mounted separately by docker-compose.yml
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=conflux-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Verification email. Replace these to send real email.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@conflux.local
EMAIL_VERIFICATION_TTL=24h
